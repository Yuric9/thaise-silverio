{
  "name": "thaise-silverio-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config dist/server/wrangler.json",
    "cloudflare:migrate": "wrangler d1 migrations apply DB --remote --config dist/server/wrangler.json",
    "deploy": "npm run build && npm run cloudflare:migrate && wrangler deploy --config dist/server/wrangler.json",
    "admin:hash-password": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
